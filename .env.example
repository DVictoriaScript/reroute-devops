# Copie para .env e preencha com os valores reais (o .env não vai para o GitHub)
# cp .env.example .env

# ---------------------------------------------------------------
# docker compose (API + Oracle local)
# ---------------------------------------------------------------
ASPNETCORE_ENVIRONMENT=Development

# Banco Oracle do container (gvenzl/oracle-free)
ORACLE_PASSWORD=troque-senha-do-sys
DB_USER=reroute
DB_PASSWORD=troque-senha-do-usuario-reroute
DB_PORT=1521

# JWT (mínimo de 32 caracteres)
JWT_SECRET_KEY=troque-por-uma-chave-com-pelo-menos-32-caracteres
JWT_ISSUER=ReRoute.Api
JWT_AUDIENCE=ReRoute.Client

# Porta da API no host (http://localhost:8080)
API_PORT=8080

# ---------------------------------------------------------------
# docker run / dotnet run apontando para o Oracle da FIAP
# (o compose não usa estas linhas; elas seguem o padrão do ASP.NET, "__" vira ":")
# ---------------------------------------------------------------
OracleConnection__ConnectionString=User Id=SEU_RM;Password=SUA_SENHA;Data Source=oracle.fiap.com.br:1521/ORCL
Jwt__SecretKey=troque-por-uma-chave-com-pelo-menos-32-caracteres
Jwt__Issuer=ReRoute.Api
Jwt__Audience=ReRoute.Client
