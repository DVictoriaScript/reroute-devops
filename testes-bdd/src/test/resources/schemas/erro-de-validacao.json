{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://example.com/reroute/erro-de-validacao.json",
  "title": "Erro de validação",
  "type": "object",
  "required": [
    "title",
    "status",
    "errors"
  ],
  "properties": {
    "type": {
      "type": "string"
    },
    "title": {
      "type": "string"
    },
    "status": {
      "type": "integer"
    },
    "errors": {
      "type": "object",
      "additionalProperties": {
        "type": "array",
        "items": {
          "type": "string"
        }
      }
    },
    "traceId": {
      "type": "string"
    }
  }
}
